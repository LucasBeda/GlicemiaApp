<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GlicemiaApp.ViewModels"
             x:Class="GlicemiaApp.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="Histórico">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,16,16,0" RowSpacing="10">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="12">
            <Label Text="Histórico" StyleClass="Title" />
            <Button Grid.Column="1" Text="+ Adicionar" Clicked="OnAddClicked"
                    HeightRequest="44" Padding="16,0" FontSize="14" VerticalOptions="Center"
                    SemanticProperties.Description="Adicionar medição ao histórico" />
            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Message}" StyleClass="Muted">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                        <Setter Property="TextColor" Value="{StaticResource Danger}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="68,*,*,*" Padding="8,0" ColumnSpacing="2">
            <Label Grid.Column="0" Text="DATA" StyleClass="ColumnHeader" HorizontalTextAlignment="Center" />
            <Label Grid.Column="1" Text="CAFÉ" StyleClass="ColumnHeader" HorizontalTextAlignment="Center" />
            <Label Grid.Column="2" Text="ALMOÇO" StyleClass="ColumnHeader" HorizontalTextAlignment="Center" />
            <Label Grid.Column="3" Text="JANTAR" StyleClass="ColumnHeader" HorizontalTextAlignment="Center" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Days}" SelectionMode="None">

            <CollectionView.EmptyView>
                <Label Text="Nenhum registro nos últimos 30 dias." StyleClass="Muted"
                       HorizontalTextAlignment="Center" Margin="0,40,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryDay">
                    <Border StyleClass="Card" Padding="8,10" Margin="0,0,0,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHistoryDayTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="68,*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="2" RowSpacing="6">
                            <Label Grid.Column="0" Text="{Binding Date}" FontSize="14"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center" />

                            <Border Grid.Column="1" Background="Transparent" StrokeThickness="0" Padding="0">
                                <Label Text="{Binding BreakfastValue}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                                       HorizontalTextAlignment="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding BreakfastStatus}" Value="Baixa">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource GlucoseLowLight}, Dark={StaticResource GlucoseLowDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding BreakfastStatus}" Value="Na meta">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource GlucoseInRangeLight}, Dark={StaticResource GlucoseInRangeDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding BreakfastStatus}" Value="Alta">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource GlucoseHighLight}, Dark={StaticResource GlucoseHighDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <Border Grid.Column="2" Background="Transparent" StrokeThickness="0" Padding="0">
                                <Label Text="{Binding LunchValue}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                                       HorizontalTextAlignment="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding LunchStatus}" Value="Baixa">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource GlucoseLowLight}, Dark={StaticResource GlucoseLowDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding LunchStatus}" Value="Na meta">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource GlucoseInRangeLight}, Dark={StaticResource GlucoseInRangeDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding LunchStatus}" Value="Alta">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource GlucoseHighLight}, Dark={StaticResource GlucoseHighDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <Border Grid.Column="3" Background="Transparent" StrokeThickness="0" Padding="0">
                                <Label Text="{Binding DinnerValue}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                                       HorizontalTextAlignment="Center" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding DinnerStatus}" Value="Baixa">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource GlucoseLowLight}, Dark={StaticResource GlucoseLowDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding DinnerStatus}" Value="Na meta">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource GlucoseInRangeLight}, Dark={StaticResource GlucoseInRangeDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding DinnerStatus}" Value="Alta">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource GlucoseHighLight}, Dark={StaticResource GlucoseHighDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <Label Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding OtherReadings}"
                                   StyleClass="Caption" IsVisible="{Binding HasOtherReadings}"
                                   LineBreakMode="WordWrap" />
                            <Label Grid.Row="2" Grid.ColumnSpan="4" Text="{Binding Note}" StyleClass="Caption"
                                   IsVisible="{Binding HasNote}" LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
